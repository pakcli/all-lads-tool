# _run.env.example - Template Configuration for All Lads Tool
# Copy this file to _run.env and fill in your actual values.
# NEVER commit _run.env with real credentials.

# Local Machine Environment
LOCAL_MACHINE_USER=mypc

# GitHub Identity
GITHUB_USERNAME=mygithubusername
GITHUB_EMAIL_PUBLIC=myemail@users.noreply.github.com

# Target & Active Project Slugs
ACTIVE_SLUG=all-lads-tool

# Allowed / Target Domains (Numbered list format based on order)
# The numbering prefix (1., 2., 3., etc.) serves as an index note in the env.
ALLOWED_DOMAINS=
1.domain.com,
2.domain.com,
3.domain.com,
4.domain.com,
5.domain.com
