using System;
using System.Runtime.InteropServices;

namespace RestartManagerFix {
    public class RmSessionTest {
        [DllImport("rstrtmgr.dll", CharSet = CharSet.Unicode)]
        public static extern int RmStartSession(out uint pSessionHandle, int dwSessionFlags, char[] strSessionKey);

        public static int Test(out uint handle, out string sessionKey) {
            handle = 0;
            char[] key = new char[33]; // CCH_RM_SESSION_KEY (32) + 1
            int res = RmStartSession(out handle, 0, key);
            sessionKey = new string(key);
            return res;
        }

        [DllImport("rstrtmgr.dll")]
        public static extern int RmEndSession(uint pSessionHandle);
    }
}
